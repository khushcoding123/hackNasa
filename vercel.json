{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "web",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://pull-paragraphs-economic-informative.trycloudflare.com/api/:path*" }
  ],
  "headers": [
    {
      "source": "/cesium/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
